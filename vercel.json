{
  "builds": [
    {
      "src": "i9car-painel/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "site-principal/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/painel(/.*)?",
      "dest": "/i9car-painel$1"
    },
    {
      "src": "/(.*)",
      "dest": "/site-principal/$1"
    }
  ]
}